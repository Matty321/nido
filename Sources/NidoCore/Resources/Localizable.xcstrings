    "%@ now leads to %@, not to the folder that was added; if that’s the right one, remove it and add it again" : {
      "comment" : "The path saved for a shared folder, then where it resolves now.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ führt jetzt zu %@, nicht zum hinzugefügten Ordner; wenn das der richtige ist, entferne ihn und füge ihn erneut hinzu"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
