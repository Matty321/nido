      }
    },
    "Suspend the VM: save its state to state.vzvmsave and stop it; the next nido start resumes from there. Only for VMs started with nido start." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM in den Ruhezustand versetzen: Zustand in state.vzvmsave sichern und die VM stoppen; der nächste Aufruf von nido start setzt sie dort fort. Nur für VMs, die mit nido start gestartet wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspender la VM: guardar su estado en state.vzvmsave y detenerla; el siguiente nido start la reanuda desde ahí. Solo para las VM iniciadas con nido start."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendre la VM : enregistrer son état dans state.vzvmsave et l’arrêter ; le prochain nido start reprend à partir de là. Seulement pour les VM démarrées avec nido start."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sospende la VM: salva lo stato in state.vzvmsave e la ferma; il prossimo nido start riprende da lì. Solo per le VM avviate con nido start."
          }
        }
      }
    },
