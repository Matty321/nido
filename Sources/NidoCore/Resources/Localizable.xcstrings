    "The VM keeps running." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM läuft weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM sigue en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
