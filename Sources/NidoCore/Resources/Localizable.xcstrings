        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NIDO_LANGUAGE (en, it, de, es ou fr) choisit la langue des messages de nido ; sinon, nido suit la langue du Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NIDO_LANGUAGE (en, it, de, es o fr) sceglie la lingua dei messaggi di nido; senza, nido segue la lingua del Mac."
          }
        }
      }
    },
