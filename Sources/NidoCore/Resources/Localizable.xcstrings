          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM aún no se ha iniciado: vuelve a intentar detenerla en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM n’a pas encore démarré : redemandez l’arrêt dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM non è ancora avviata: ripeti la richiesta di arresto tra poco."
          }
        }
      }
    },
    "The VM is in an unexpected state: stop it with Ctrl-C or nido stop %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM ist in einem unerwarteten Zustand: Stoppe sie mit Ctrl-C oder nido stop %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM está en un estado inesperado: detenla con Ctrl-C o nido stop %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM est dans un état inattendu : arrêtez-la avec Ctrl-C ou nido stop %@."
          }
        },
        "it" : {
