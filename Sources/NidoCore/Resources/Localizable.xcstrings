    },
    "%@ covers every name under %@: the sites and services of anyone with an address there, not a single site. Add it anyway? Touch ID or the Mac password comes next. [y/N] " : {
      "comment" : "A wildcard domain (*.co.uk), then its suffix (co.uk). [y/N]: the letter that answers yes in this language, N for no.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gilt für jeden Namen unter %@: Websites und Dienste aller, die dort eine Adresse haben, nicht nur einer einzelnen Website. Trotzdem hinzufügen? Danach sind Touch ID oder das Passwort deines Mac nötig. [j/N] "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vale para cualquier nombre bajo %@: sitios y servicios de cualquiera que tenga allí una dirección, no de un solo sitio. ¿Añadirlo de todos modos? Después se pedirá Touch ID o la contraseña del Mac. [s/N] "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ couvre tous les noms sous %@ : les sites et services de tous ceux qui y ont une adresse, et non un seul site. L’ajouter quand même ? Touch ID ou le mot de passe du Mac sera ensuite demandé. [o/N] "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vale per ogni nome sotto %@: siti e servizi di chiunque vi abbia un indirizzo, non di un solo sito. Aggiungerlo comunque? Dopo serve Touch ID o la password del Mac. [s/N] "
          }
        }
      }
    },
