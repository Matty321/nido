    "Suspend requested: waiting for the VM to save its state…" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhezustand angefordert: Warte, bis die VM ihren Zustand gesichert hat …"
          }
