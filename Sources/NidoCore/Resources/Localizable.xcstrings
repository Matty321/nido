    "%@ is invalid or unsafe (a link, too large, or invalid JSON): Nido doesn’t use it, and a running VM keeps the last valid list. To rewrite it with the base list: nido net reset %@" : {
      "comment" : "The path of egress.json, then a VM name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ungültig oder nicht sicher (ein Link, zu groß oder ungültiges JSON): Nido verwendet die Datei nicht und eine laufende VM behält die letzte gültige Liste. Mit der Basisliste neu schreiben: nido net reset %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es válido o no es seguro (un enlace, demasiado grande o JSON no válido): Nido no lo usa y la VM en ejecución se queda con la última lista válida. Para reescribirlo con la lista básica: nido net reset %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas valide ou pas sûr (un lien, trop volumineux ou JSON non valide) : Nido ne l’utilise pas et la VM en marche garde la dernière liste valide. Pour le réécrire avec la liste de base : nido net reset %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è valido o non è sicuro (un link, troppo grande, JSON non valido): Nido non lo usa e la VM accesa resta sull'ultima lista valida. Per riscriverlo con la lista di base: nido net reset %@"
          }
        }
      }
    },
    "%@ isn’t a template: save it first with nido template save" : {
