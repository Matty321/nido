    "Suspend refused: the VM is resuming from its saved state; try again shortly." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhezustand abgelehnt: Die VM wird gerade aus dem Ruhezustand fortgesetzt; versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
