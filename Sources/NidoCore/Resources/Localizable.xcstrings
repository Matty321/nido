        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arresto richiesto: se la sospensione non riesce, la VM si arresta subito dopo."
          }
        }
      }
    },
    "Stop sharing a folder with a stopped VM." : {
