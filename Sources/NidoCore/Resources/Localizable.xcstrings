    "%@ is a folder or a special item: Nido leaves it alone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Ordner oder ein spezielles Objekt: Nido lässt es unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una carpeta o un elemento especial: Nido no lo toca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un dossier ou un élément spécial : Nido n’y touche pas."
