    "The VM %@ is still running: the suspend didn’t finish in time. See the terminal running nido start for details." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM %@ läuft noch: Der Ruhezustand wurde nicht rechtzeitig erreicht. Die Details stehen im Terminal von nido start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM %@ sigue en ejecución: la suspensión no ha terminado a tiempo. Los detalles están en el terminal de nido start."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM %@ est toujours en marche : la suspension ne s’est pas terminée à temps. Consultez le terminal où s’exécute nido start pour en savoir plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM %@ è ancora in esecuzione: la sospensione non è finita in tempo. I dettagli sono nel terminale di nido start."
          }
        }
      }
    },
    "The VM %@ stopped without saving its state: its next start will be a cold boot. See the terminal running nido start for details." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM %@ wurde gestoppt, ohne ihren Zustand zu sichern: Sie führt beim nächsten Start einen Kaltstart aus. Die Details stehen im Terminal von nido start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM %@ se ha detenido sin guardar su estado: en el próximo inicio arrancará en frío. Los detalles están en el terminal de nido start."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM %@ s’est arrêtée sans enregistrer son état : au prochain démarrage, elle démarrera à froid. Consultez le terminal où s’exécute nido start pour en savoir plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM %@ si è arrestata senza salvare lo stato: al prossimo avvio parte a freddo. I dettagli sono nel terminale di nido start."
          }
        }
      }
    },
    "The VM %@ wasn’t suspended: %@" : {
      "comment" : "The reason comes from the nido start process: “it’s already stopping”, or an error message.",
