            "state" : "translated",
            "value" : "Arrêt demandé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arresto richiesto."
          }
        }
      }
    },
    "Stop requested: if the suspend fails, the VM stops after it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppen angefordert: Schlägt das Versetzen in den Ruhezustand fehl, wird die VM danach gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detención solicitada: si la suspensión falla, la VM se detendrá después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêt demandé : si la suspension échoue, la VM s’arrêtera ensuite."
