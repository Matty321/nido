          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo stato salvato è stato scartato perché non appartiene a una sospensione valida"
          }
        }
      }
    },
    "The settings changed after the snapshot: at the next start, the saved state will be discarded and the VM will cold-boot." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
