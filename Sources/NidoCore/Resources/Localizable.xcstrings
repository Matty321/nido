      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet eine VM im Vordergrund (Ctrl-C stoppt sie); setzt eine VM im Ruhezustand fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una VM en primer plano (Ctrl-C la detiene); reanuda una VM suspendida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarre une VM au premier plan (Ctrl-C l’arrête) ; reprend une VM suspendue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia una VM in primo piano (Ctrl-C la arresta); riprende una VM sospesa."
          }
        }
      }
    },
    "Stop requested while resuming: the VM %@ wasn’t resumed and its saved state was discarded." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppen während des Fortsetzens angefordert: Die VM %@ wurde nicht fortgesetzt und ihr gesicherter Zustand wurde verworfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detención solicitada durante la reanudación: la VM %@ no se ha reanudado y se ha descartado su estado guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêt demandé pendant la reprise : la VM %@ n’a pas été reprise et son état enregistré a été supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arresto richiesto durante la ripresa: la VM %@ non è stata ripresa e lo stato sospeso è stato scartato."
          }
        }
      }
    },
    "Stop requested." : {
      "extractionState" : "manual",
      "localizations" : {
