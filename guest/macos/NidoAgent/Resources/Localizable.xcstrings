    "So Nido can reach this Mac after every restart." : {
      "comment" : "Permissions window: why Nido Agent opens at login.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit Nido diesen Mac nach jedem Neustart erreicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que Nido pueda llegar a este Mac tras cada reinicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour que Nido puisse joindre ce Mac après chaque redémarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Così Nido può raggiungere questo Mac dopo ogni riavvio."
