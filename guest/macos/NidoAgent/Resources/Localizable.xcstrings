    "After allowing Screen Recording, macOS may ask you to quit and reopen Nido Agent." : {
      "comment" : "Permissions window: footnote.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem du die Bildschirmaufnahme erlaubt hast, bittet macOS dich eventuell, Nido Agent zu beenden und neu zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de permitir la grabación de pantalla, puede que macOS te pida salir de Nido Agent y volver a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir autorisé l’enregistrement de l’écran, macOS peut vous demander de quitter et de rouvrir Nido Agent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver consentito la registrazione dello schermo, macOS potrebbe chiederti di chiudere e riaprire Nido Agent."
          }
        }
      }
    },
    "Agent access is off for this VM in Nido" : {
      "comment" : "Menu-bar state: the VM has no vsock device because agent access is off on the host.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent-Zugriff ist für diese VM in Nido ausgeschaltet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso del agente está desactivado para esta VM en Nido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès agent est désactivé pour cette VM dans Nido"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso dell’agente è disattivato per questa VM in Nido"
          }
        }
      }
    },
    "Allow Opening at Login…" : {
