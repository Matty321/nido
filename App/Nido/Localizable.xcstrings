    },
    "You can install the Guest Tools yourself with the commands below, from a session in the VM." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst die Guest Tools mit den Befehlen unten selbst installieren, über eine Sitzung in der VM."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes instalar tú mismo las Guest Tools con los comandos de abajo, desde una sesión en la VM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez installer les Guest Tools vous-même avec les commandes ci-dessous, depuis une session dans la VM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi installare i Guest Tools a mano con i comandi qui sotto, da una sessione nella VM."
          }
        }
      }
    },
    "You can quit when the copy is done, or stop it: the partial copy is removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Nido nach dem Kopieren beenden oder das Kopieren abbrechen: Die unvollständige Kopie wird entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes salir cuando termine la copia o interrumpirla: la copia parcial se elimina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez quitter une fois la copie terminée, ou l’interrompre : la copie partielle est supprimée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi uscire al termine della copia, oppure interromperla: la copia parziale viene rimossa."
          }
        }
      }
    },
    "You confirm with Touch ID or the Mac password." : {
