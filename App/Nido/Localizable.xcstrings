          }
        }
      }
    },
    "%@ used" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ belegt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilisés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usati"
          }
        }
      }
    },
    "%@ was created before Nido 0.7.4 and still makes background requests that end up in the log as blocks. Turn Off stops them right away, with the VM running; it’s also in Settings › Guest Tools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde vor Nido 0.7.4 erstellt und stellt noch Hintergrundanfragen, die als Blockierungen im Protokoll landen. „Deaktivieren“ stoppt sie sofort bei laufender VM; die Option gibt es auch unter Einstellungen › Guest Tools."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se creó antes de Nido 0.7.4 y todavía hace solicitudes en segundo plano que acaban en el registro como bloqueos. Desactivar las detiene al momento, con la VM en ejecución; también está en Ajustes › Guest Tools."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été créée avant Nido 0.7.4 et fait encore des requêtes en arrière-plan qui apparaissent dans le journal comme des blocages. Le bouton Désactiver les arrête aussitôt, avec la VM en marche ; l’option se trouve aussi dans Réglages › Guest Tools."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stata creata prima di Nido 0.7.4 e fa ancora richieste di sfondo che finiscono nel registro come blocchi. Spegni le ferma da subito, con la VM accesa; resta anche in Impostazioni › Guest Tools."
          }
        }
      }
    },
    "%@ was created without Guest Tools or with an earlier version of Nido. The monitor starts responding after the next restart." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde ohne Guest Tools oder mit einer früheren Version von Nido erstellt. Der Monitor antwortet ab dem nächsten Neustart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se creó sin Guest Tools o con una versión anterior de Nido. El monitor responde a partir del próximo reinicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été créée sans Guest Tools ou avec une version antérieure de Nido. Le moniteur répond à partir du prochain redémarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stata creata senza Guest Tools o con una versione di Nido precedente. Il monitor risponde dal prossimo riavvio."
          }
        }
      }
    },
    "%@ wasn’t suspended (%@): it was stopped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde nicht in den Ruhezustand versetzt, sondern gestoppt. Grund: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se ha suspendido (%@): se ha detenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas été suspendue (%@) : elle a été arrêtée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è stata sospesa (%@): è stata arrestata."
          }
        }
      }
    },
    "%@ will be usable at the end of phase 1." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist am Ende von Phase 1 einsatzbereit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se podrá usar al final de la fase 1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera utilisable à la fin de la phase 1."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sarà usabile alla fine della fase 1."
          }
        }
      }
    },
    "%@ will be usable at the end of phase 1. Ollama and the model come later, without blocking it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist am Ende von Phase 1 einsatzbereit. Ollama und das Modell folgen danach, ohne sie zu blockieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se podrá usar al final de la fase 1. Ollama y el modelo llegan después, sin bloquearla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera utilisable à la fin de la phase 1. Ollama et le modèle d’IA arrivent ensuite, sans la bloquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sarà usabile alla fine della fase 1. Ollama e il modello arrivano dopo, senza bloccarla."
          }
