          }
        }
      }
    },
    "%@ has no guest monitor: it was created without Guest Tools or with an earlier version of Nido. Nido installs them over SSH without touching packages, files and models; the monitor starts responding after the next restart." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keinen Monitor im Gastsystem, weil sie ohne Guest Tools oder mit einer früheren Version von Nido erstellt wurde. Nido installiert sie über SSH, ohne Pakete, Dateien und Modelle anzurühren; der Monitor antwortet ab dem nächsten Neustart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no tiene monitor del sistema invitado: se creó sin Guest Tools o con una versión anterior de Nido. Nido las instala por SSH sin tocar paquetes, archivos ni modelos; el monitor responde a partir del próximo reinicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas de moniteur du système invité : elle a été créée sans Guest Tools ou avec une version antérieure de Nido. Nido les installe via SSH sans toucher aux paquets, aux fichiers ni aux modèles d’IA ; le moniteur répond à partir du prochain redémarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha il monitor del guest: è stata creata senza Guest Tools o con una versione di Nido precedente. Nido li installa via SSH senza toccare pacchetti, file e modelli; il monitor risponde dal prossimo riavvio."
          }
        }
      }
