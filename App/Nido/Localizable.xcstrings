    "After Setup Assistant, turn on Remote Login in macOS: the Terminal Access panel in the VM’s window guides you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere nach dem Systemassistenten „Entfernte Anmeldung“ in macOS: Der Bereich „Zugriff über Terminal“ im Fenster der VM hilft dir dabei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después del Asistente de Configuración, activa Sesión remota en macOS: el panel Acceso desde Terminal de la ventana de la VM te guía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l’Assistant réglages, activez Session à distance dans macOS : le panneau Accès depuis Terminal de la fenêtre de la VM vous guide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo l'assistente iniziale attiva Login remoto in macOS: il pannello Accesso da terminale della finestra della VM ti guida."
