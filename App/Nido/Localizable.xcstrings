    "Same computer name, same account with its authorized keys, same SSH host keys. After cloning, Nido shows you the commands to change them in the copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicher Computername, gleicher Account mit seinen autorisierten Schlüsseln, gleiche SSH-Hostschlüssel. Nach dem Klonen zeigt dir Nido die Befehle, um sie in der Kopie zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mismo nombre del ordenador, misma cuenta con sus claves autorizadas, mismas claves de host SSH. Después de clonar, Nido te muestra los comandos para cambiarlos en la copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même nom d’ordinateur, même compte avec ses clés autorisées, mêmes clés d’hôte SSH. Après le clonage, Nido vous indique les commandes pour les modifier dans la copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stesso nome del computer, stesso account con le sue chiavi autorizzate, stesse chiavi host SSH. Dopo la clonazione Nido ti mostra i comandi per cambiarli nella copia."
          }
        }
      }
