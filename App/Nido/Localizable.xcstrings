        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist im Ruhezustand"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is suspended"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está suspendida"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est suspendue"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è sospesa"
          }
        }
      }
    },
    "%@ is suspended: Nido saves its disk, settings and suspended state, which resumes where you left off after a restore." : {
      "comment" : "%@ is the VM's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist im Ruhezustand: Nido sichert Festplatte, Einstellungen und den Ruhezustand; nach einer Wiederherstellung geht es dort weiter, wo du aufgehört hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está suspendida: Nido guarda el disco, los ajustes y el estado suspendido, que tras una restauración continúa donde lo dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est suspendue : Nido enregistre le disque, les réglages et l’état suspendu, qui reprend là où vous l’aviez laissé après une restauration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è sospesa: Nido salva disco, impostazioni e lo stato sospeso, che dopo un ripristino riprende da dove l'hai lasciata."
          }
        }
      }
    },
    "%@ is suspended: if you change CPU, memory or shared folders, the next start discards the saved state and the VM starts from scratch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist im Ruhezustand: Wenn du CPU, Arbeitsspeicher oder geteilte Ordner änderst, wird beim nächsten Start der gesicherte Zustand verworfen und die VM führt einen Kaltstart aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está suspendida: si cambias la CPU, la memoria o las carpetas compartidas, en el próximo inicio se descartará el estado guardado y la VM empezará de cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est suspendue : si vous modifiez le CPU, la mémoire ou les dossiers partagés, l’état enregistré sera supprimé au prochain démarrage et la VM repartira de zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è sospesa: se cambi CPU, memoria o cartelle condivise, al prossimo avvio lo stato salvato verrà scartato e la VM partirà da capo."
          }
        }
      }
    },
    "%@ is suspended: if you change CPU, memory, shared folders or Rosetta, the next start discards the saved state and the VM starts from scratch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist im Ruhezustand: Wenn du CPU, Arbeitsspeicher, geteilte Ordner oder Rosetta änderst, wird beim nächsten Start der gesicherte Zustand verworfen und die VM führt einen Kaltstart aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está suspendida: si cambias la CPU, la memoria, las carpetas compartidas o Rosetta, en el próximo inicio se descartará el estado guardado y la VM empezará de cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est suspendue : si vous modifiez le CPU, la mémoire, les dossiers partagés ou Rosetta, l’état enregistré sera supprimé au prochain démarrage et la VM repartira de zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è sospesa: se cambi CPU, memoria, cartelle condivise o Rosetta, al prossimo avvio lo stato salvato verrà scartato e la VM partirà da capo."
          }
        }
      }
    },
    "%@ left" : {
      "comment" : "%@ is the time left: about 9 min.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "noch %@"
          }
        },
        "es" : {
