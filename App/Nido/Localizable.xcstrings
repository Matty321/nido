            "value" : "%@ sur %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ di %@"
          }
        }
      }
    },
    "%@ on the Mac" : {
      "comment" : "%@ is a size: the templates' space.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ auf dem Mac"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en el Mac"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sur le Mac"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sul Mac"
          }
        }
      }
    },
    "%@ publishes new builds with security fixes. The check downloads only the checksum list." : {
      "comment" : "%@ is Debian or Ubuntu.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ veröffentlicht neue Builds mit Sicherheitskorrekturen. Die Prüfung lädt nur die Prüfsummenliste herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ publica nuevas compilaciones con correcciones de seguridad. La comprobación solo descarga la lista de sumas de control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ publie de nouveaux builds avec des correctifs de sécurité. La vérification ne télécharge que la liste des sommes de contrôle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pubblica nuove build con le correzioni di sicurezza. Il controllo scarica solo la lista dei checksum."
          }
        }
      }
    },
    "%@ stays in memory where you left it. Resume to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bleibt im Arbeitsspeicher an der Stelle, an der du sie verlassen hast. Klicke auf „Fortsetzen“, um weiterzumachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se queda en memoria donde la dejaste. Reanúdala para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reste en mémoire là où vous l’avez laissée. Reprenez-la pour continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ resta in memoria dove l'hai lasciata. Riprendi per continuare."
          }
        }
      }
    },
    "%@ stays paused for a few seconds while Nido saves its memory and disk." : {
      "comment" : "%@ is the VM's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bleibt einige Sekunden angehalten, während Nido Arbeitsspeicher und Festplatte sichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ permanece en pausa unos segundos mientras Nido guarda la memoria y el disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reste en pause quelques secondes pendant que Nido enregistre la mémoire et le disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ resta in pausa qualche secondo mentre Nido salva memoria e disco."
          }
        }
      }
    },
    "%@ stopped on its own at %@. These are the values from %@; the monitor resumes at the next start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde um %@ beendet, ohne dass du sie gestoppt hast. Das sind die Werte um %@; der Monitor läuft beim nächsten Start wieder an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se ha detenido a las %@ sin que lo pidieras. Estos son los valores de las %@; el monitor vuelve a funcionar en el próximo inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s’est arrêtée à %@ sans que vous l’ayez demandé. Voici les valeurs relevées à %@ ; le moniteur reprend au prochain démarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ si è fermata alle %@ senza che lo chiedessi. Questi sono i valori delle %@; il monitor riparte al prossimo avvio."
          }
        }
      }
    },
    "%@ tokens/s" : {
      "comment" : "Ollama’s generation speed: %@ is a decimal number.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
