    "Check that the VM is running and the ssh service is on, then click Try Again, or install the Guest Tools yourself with the commands below, from a session in the VM." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob die VM läuft und der Dienst ssh aktiv ist, und klicke dann auf „Erneut versuchen“ – oder installiere die Guest Tools mit den Befehlen unten selbst, über eine Sitzung in der VM."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que la VM está en ejecución y que el servicio ssh está activo y haz clic en Reintentar, o instala tú mismo las Guest Tools con los comandos de abajo, desde una sesión en la VM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que la VM est en marche et que le service ssh est actif, puis cliquez sur Réessayer, ou installez les Guest Tools vous-même avec les commandes ci-dessous, depuis une session dans la VM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla che la VM sia accesa e che il servizio ssh sia attivo e premi Riprova, oppure installa i Guest Tools a mano con i comandi qui sotto, da una sessione nella VM."
          }
        }
      }
    },
    "Check your choices: Nido copies %@ to %@ and starts it." : {
      "comment" : "%1$@: the template; %2$@: the new VM.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe deine Auswahl: Nido kopiert %@ nach %@ und startet die VM."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa tus opciones: Nido copia %@ en %@ y la inicia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez vos choix : Nido copie %@ vers %@ et la démarre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla le scelte: Nido copia %@ in %@ e la avvia."
          }
        }
      }
    },
    "Check your choices: Nido creates %@ and starts it as soon as it’s ready." : {
      "comment" : "%@ is the new VM's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe deine Auswahl: Nido erstellt %@ und startet die VM, sobald sie bereit ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa tus opciones: Nido crea %@ y la inicia en cuanto esté lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez vos choix : Nido crée %@ et la démarre dès qu’elle est prête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla le scelte: Nido crea %@ e la avvia appena è pronta."
          }
        }
      }
    },
    "Check your choices: Nido installs macOS on %@ and starts it for Setup Assistant." : {
      "comment" : "%@ is the new VM's name.",
      "localizations" : {
        "de" : {
