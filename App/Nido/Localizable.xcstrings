    },
    "The VM isn’t running: start it to use the chat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM läuft nicht: Starte sie, um den Chat zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM no está en ejecución: iníciala para usar el chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM n’est pas en marche : démarrez-la pour utiliser la conversation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM non è in esecuzione: avviala per usare la chat."
          }
        }
      }
    },
    "The VM may still be running: Nido keeps its lock until it stops. Stop it from the toolbar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM läuft möglicherweise noch: Nido behält ihre Sperre, bis sie stoppt. Stoppe sie über die Symbolleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que la VM siga en ejecución: Nido mantiene su bloqueo hasta que se detenga. Detenla desde la barra de herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM est peut-être encore en marche : Nido garde son verrou jusqu’à son arrêt. Arrêtez-la depuis la barre d’outils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM potrebbe essere ancora accesa: Nido tiene il suo lock finché non si ferma. Arrestala dalla barra."
          }
        }
      }
    },
    "The VM reaches only %@. You can add other domains in the VM’s settings, Network section." : {
      "comment" : "%@ is a list of domains.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM erreicht nur %@. Weitere Domains fügst du in den Einstellungen der VM im Bereich „Netzwerk“ hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM solo llega a %@. Puedes añadir otros dominios en los ajustes de la VM, sección Red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM n’accède qu’à %@. Vous pouvez ajouter d’autres domaines dans les réglages de la VM, section Réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM raggiunge solo %@. Altri domini si aggiungono nelle impostazioni della VM, sezione Rete."
          }
        }
      }
    },
    "The VM reaches only the domains on the list. Every block ends up in the log and in a notice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM erreicht nur die Domains der Liste. Jede Blockierung landet im Protokoll und in einem Hinweis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM solo llega a los dominios de la lista. Cada bloqueo queda en el registro y en un aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM n’atteint que les domaines de la liste. Chaque blocage est consigné dans le journal et signalé par un avis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM raggiunge solo i domini della lista. Ogni blocco finisce nel registro e in un avviso."
          }
        }
      }
    },
    "The VM reads the files but can’t change or delete them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM liest die Dateien, kann sie aber weder ändern noch löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM lee los archivos, pero no puede modificarlos ni eliminarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM lit les fichiers mais ne peut ni les modifier ni les supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM legge i file ma non può modificarli né cancellarli."
          }
        }
      }
    },
    "The VM runs Linux programs for Intel (x86_64) with Rosetta." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM führt Linux-Programme für Intel (x86_64) mit Rosetta aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM ejecuta programas de Linux para Intel (x86_64) con Rosetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM exécute les programmes Linux pour Intel (x86_64) avec Rosetta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM esegue i programmi Linux per Intel (x86_64) con Rosetta."
          }
        }
      }
    },
    "The VM stopped because of an error" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM wurde wegen eines Fehlers gestoppt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM se ha detenido por un error"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM s’est arrêtée à cause d’une erreur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM si è fermata per un errore"
          }
        }
      }
    },
    "The VM will go back to its state as of %@; later changes and the saved state of %@ will be lost." : {
      "comment" : "%1$@: the snapshot's date and time; %2$@: the VM's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM kehrt zum Stand vom %@ zurück; spätere Änderungen und der gesicherte Zustand von %@ gehen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM volverá al estado del %@; los cambios posteriores y el estado guardado de %@ se perderán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM reviendra à son état du %@ ; les modifications ultérieures et l’état enregistré de %@ seront perdus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM tornerà allo stato del %@; le modifiche successive e la sessione sospesa di %@ andranno perse."
          }
        }
      }
    },
    "The VM will go back to its state as of %@; later changes will be lost." : {
      "comment" : "%@ is the snapshot's date and time.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM kehrt zum Stand vom %@ zurück; spätere Änderungen gehen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM volverá al estado del %@; los cambios posteriores se perderán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM reviendra à son état du %@ ; les modifications ultérieures seront perdues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM tornerà allo stato del %@; le modifiche successive andranno perse."
          }
        }
      }
    },
    "The VM’s configuration can’t be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konfiguration der VM kann nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer la configuración de la VM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire la configuration de la VM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurazione della VM non leggibile."
          }
        }
      }
    },
    "The VM’s disk (disk.img) can’t be read. Check the free space on the Mac and start it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Festplatte der VM (disk.img) lässt sich nicht lesen. Prüfe den freien Speicherplatz auf dem Mac und starte die VM erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco de la VM (disk.img) no se puede leer. Comprueba el espacio libre en el Mac y vuelve a iniciarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque de la VM (disk.img) est illisible. Vérifiez l’espace libre sur le Mac, puis démarrez-la à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disco della VM (disk.img) non è leggibile. Controlla lo spazio libero sul Mac e avviala di nuovo."
          }
        }
      }
    },
    "The VM’s public key (authorized_key.pub) can’t be read safely: type the command yourself with your key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der öffentliche Schlüssel der VM (authorized_key.pub) lässt sich nicht sicher lesen: Gib den Befehl selbst mit deinem Schlüssel ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave pública de la VM (authorized_key.pub) no se puede leer de forma segura: escribe el comando tú mismo con tu clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé publique de la VM (authorized_key.pub) ne peut pas être lue en toute sécurité : saisissez la commande vous-même avec votre clé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave pubblica della VM (authorized_key.pub) non si può leggere in sicurezza: scrivi il comando a mano con la tua chiave."
          }
        }
      }
    },
    "The VM’s public key (authorized_key.pub) isn’t in its folder: type the command yourself with your key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der öffentliche Schlüssel der VM (authorized_key.pub) ist nicht in ihrem Ordner: Gib den Befehl selbst mit deinem Schlüssel ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave pública de la VM (authorized_key.pub) no está en su carpeta: escribe el comando tú mismo con tu clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé publique de la VM (authorized_key.pub) ne se trouve pas dans son dossier : saisissez la commande vous-même avec votre clé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave pubblica della VM (authorized_key.pub) non si trova nella sua cartella: scrivi il comando a mano con la tua chiave."
          }
        }
      }
    },
    "The VM’s public key isn’t a one-line OpenSSH key: Nido doesn’t type it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der öffentliche Schlüssel der VM ist kein einzeiliger OpenSSH-Schlüssel: Nido gibt ihn nicht ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave pública de la VM no es una clave OpenSSH de una sola línea: Nido no la escribe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé publique de la VM n’est pas une clé OpenSSH sur une ligne : Nido ne la saisit pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave pubblica della VM non è una chiave OpenSSH su una riga: Nido non la digita."
          }
        }
      }
    },
    "The VM’s screen isn’t shown: start the VM and try again. If typing had begun, the command may be only partly typed: clear the line in the VM’s Terminal before you try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bildschirm der VM ist nicht zu sehen: Starte die VM und versuche es erneut. Wenn die Eingabe schon begonnen hatte, steht der Befehl eventuell nur zum Teil da: Lösche die Zeile im Terminal der VM, bevor du es erneut versuchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla de la VM no se ve: inicia la VM y vuelve a intentarlo. Si ya se había empezado a escribir, puede que el comando esté escrito solo en parte: borra la línea en la app Terminal de la VM antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran de la VM n’est pas affiché : démarrez la VM et réessayez. Si la saisie avait commencé, la commande n’est peut-être saisie qu’en partie : effacez la ligne dans le Terminal de la VM avant de réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo schermo della VM non è visibile: avvia la VM e riprova. Se avevi cominciato a digitare, il comando potrebbe essere scritto solo in parte: cancella la riga nel Terminale della VM prima di riprovare."
          }
        }
      }
    },
    "The VM’s state is saved on the Mac: Resume to continue where you left off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zustand der VM ist auf dem Mac gesichert: Mit „Fortsetzen“ machst du dort weiter, wo du aufgehört hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estado de la VM está guardado en el Mac: haz clic en Reanudar para continuar donde lo dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’état de la VM est enregistré sur le Mac : cliquez sur Reprendre pour continuer là où vous l’aviez laissée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo stato della VM è salvato sul Mac: Riprendi per continuare da dove l'hai lasciata."
          }
        }
      }
    },
    "The bridge answers only while %@ is running in Nido. The token stays on the Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Brücke antwortet nur, während %@ in Nido läuft. Das Token bleibt auf dem Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puente solo responde mientras %@ está en ejecución en Nido. El token se queda en el Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pont ne répond que lorsque %@ est en marche dans Nido. Le jeton reste sur le Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ponte risponde solo mentre %@ è in esecuzione in Nido. Il token resta sul Mac."
          }
        }
      }
    },
    "The cached copy is the current build." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie im Cache ist der aktuelle Build."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de la caché es la compilación actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie en cache est le build actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia nella cache è la build attuale."
          }
        }
      }
    },
    "The character %@ can’t be typed with this Mac’s keyboard: type the command yourself in the VM." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zeichen %@ lässt sich mit der Tastatur dieses Mac nicht eingeben: Gib den Befehl selbst in der VM ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El carácter %@ no se puede escribir con el teclado de este Mac: escribe el comando tú mismo en la VM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le caractère %@ ne peut pas être saisi avec le clavier de ce Mac : saisissez la commande vous-même dans la VM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carattere %@ non si può digitare con la tastiera di questo Mac: scrivi il comando a mano nella VM."
          }
        }
      }
    },
    "The chat stays in %@: nothing leaves the Mac and Nido doesn’t save it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Chat bleibt in %@: Nichts verlässt den Mac und Nido sichert ihn nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El chat se queda en %@: nada sale del Mac y Nido no lo guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conversation reste dans %@ : rien ne quitte le Mac et Nido ne l’enregistre pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chat resta in %@: nulla esce dal Mac e Nido non la salva."
          }
        }
      }
    },
    "The check failed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfung fehlgeschlagen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La verificación ha fallado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la vérification"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica non riuscita"
          }
        }
      }
    },
    "The check failed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfung fehlgeschlagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error en la comprobación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la vérification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllo non riuscito."
          }
        }
      }
    },
    "The conversation with %@ will be cleared: Nido keeps no copy." : {
      "comment" : "%@ is the VM’s name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Unterhaltung mit %@ wird gelöscht: Nido behält keine Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conversación con %@ desaparece: Nido no guarda ninguna copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conversation avec %@ disparaît : Nido n’en garde aucune copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conversazione con %@ sparisce: Nido non ne tiene copia."
          }
        }
      }
    },
    "The conversation with %@ will be cleared: Nido keeps no copy. The answer in progress is stopped." : {
      "comment" : "%@ is the VM’s name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Unterhaltung mit %@ wird gelöscht: Nido behält keine Kopie. Die Antwort, die gerade eintrifft, wird abgebrochen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conversación con %@ desaparece: Nido no guarda ninguna copia. La respuesta que está llegando se interrumpe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conversation avec %@ disparaît : Nido n’en garde aucune copie. La réponse en cours est interrompue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conversazione con %@ sparisce: Nido non ne tiene copia. La risposta in arrivo viene interrotta."
          }
        }
      }
    },
    "The copy gets a new network address and a new identity; at first boot it takes the new name as its host name. Rosetta is copied; shared folders, snapshots and the suspended state aren’t: the copy starts without shared folders. The AI bridge stays off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie erhält eine neue Netzwerkadresse und eine neue Identität; beim ersten Start übernimmt sie den neuen Namen als Hostnamen. Rosetta wird mitkopiert, geteilte Ordner, Schnappschüsse und der gesicherte Zustand nicht: Die Kopie startet ohne geteilte Ordner. Die KI-Brücke bleibt aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia tendrá una nueva dirección de red y una nueva identidad; en el primer arranque toma el nuevo nombre como nombre de host. Rosetta se copia; las carpetas compartidas, las instantáneas y el estado suspendido, no: la copia arranca sin carpetas compartidas. El puente de IA sigue desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie aura une nouvelle adresse réseau et une nouvelle identité ; au premier démarrage, elle prend le nouveau nom comme nom d’hôte. Rosetta est copié ; les dossiers partagés, les instantanés et l’état suspendu ne le sont pas : la copie démarre sans dossiers partagés. Le pont IA reste désactivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia avrà un nuovo indirizzo di rete e una nuova identità; al primo avvio prende il nuovo nome come nome host. Rosetta viene copiata; cartelle condivise, snapshot e stato sospeso no: la copia parte senza cartelle condivise. Il ponte AI resta spento."
          }
        }
      }
    },
    "The copy gets a new network address and a new machine identifier. Shared folders, snapshots and the suspended state aren’t copied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie erhält eine neue Netzwerkadresse und eine neue Maschinenkennung. Geteilte Ordner, Schnappschüsse und der gesicherte Zustand werden nicht kopiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia tendrá una nueva dirección de red y un nuevo identificador de máquina. Las carpetas compartidas, las instantáneas y el estado suspendido no se copian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie aura une nouvelle adresse réseau et un nouvel identifiant de machine. Les dossiers partagés, les instantanés et l’état suspendu ne sont pas copiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia avrà un nuovo indirizzo di rete e un nuovo identificatore della macchina. Cartelle condivise, snapshot e stato sospeso non vengono copiati."
          }
        }
      }
    },
    "The disk must be at least 1 GiB." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Festplatte muss mindestens 1 GiB groß sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco debe tener al menos 1 GiB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque doit faire au moins 1 GiB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disco deve essere di almeno 1 GiB."
          }
        }
      }
    },
    "The disk must hold the image: at least %lld GiB." : {
      "comment" : "A disk size. [not a count]",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Festplatte muss das Image aufnehmen können: mindestens %lld GiB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco debe poder contener la imagen: al menos %lld GiB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque doit pouvoir contenir l’image : au moins %lld GiB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disco deve contenere l'immagine: almeno %lld GiB."
          }
        }
      }
    },
    "The disk ran out of space during the installation: 66 GiB needed, 41 GiB left on the Mac. Nido deleted the files it created; the IPSW stays where it is." : {
      "comment" : "Screenshot fixture (debug builds): a failed installation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Installation ist der Speicherplatz ausgegangen: 66 GiB erforderlich, auf dem Mac sind noch 41 GiB frei. Nido hat die erstellten Dateien gelöscht; die IPSW-Datei bleibt, wo sie ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha agotado el espacio en disco durante la instalación: se necesitan 66 GiB y en el Mac quedan 41 GiB. Nido ha eliminado los archivos creados; el IPSW se queda donde está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace disque épuisé pendant l’installation : 66 GiB nécessaires, il reste 41 GiB sur le Mac. Nido a supprimé les fichiers créés ; le fichier IPSW reste où il est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio su disco esaurito durante l'installazione: servono 66 GiB, sul Mac ne restano 41 GiB. Nido ha cancellato i file creati; l'IPSW resta dov'è."
          }
        }
      }
    },
    "The disk size is chosen when the VM is created." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Größe der Festplatte wird beim Erstellen der VM festgelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño del disco se elige al crear la VM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille du disque se choisit à la création de la VM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dimensione del disco si sceglie alla creazione."
          }
        }
      }
    },
    "The disk takes space on the Mac only when the VM writes data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Festplatte belegt nur dann Speicherplatz auf dem Mac, wenn die VM Daten schreibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco solo ocupa espacio en el Mac cuando la VM escribe datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque n’occupe de l’espace sur le Mac que lorsque la VM écrit des données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disco occupa spazio sul Mac solo quando la VM scrive dati."
          }
        }
      }
    },
    "The first boot didn’t start the guest monitor within 5 minutes. Look at the console in the Screen view; if cloud-init has finished, install the Guest Tools over SSH." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Start hat den Monitor im Gastsystem nicht innerhalb von 5 Minuten gestartet. Sieh dir die Konsole in der Ansicht „Bildschirm“ an; wenn cloud-init fertig ist, installiere die Guest Tools über SSH."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer arranque no ha iniciado el monitor del sistema invitado en 5 minutos. Mira la consola en la vista Pantalla; si cloud-init ha terminado, instala las Guest Tools por SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier démarrage n’a pas lancé le moniteur du système invité en 5 minutes. Consultez la console dans la vue Écran ; si cloud-init a terminé, installez les Guest Tools via SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo avvio non ha avviato il monitor del guest entro 5 minuti. Guarda la console nella vista Schermo; se cloud-init ha finito, installa i Guest Tools via SSH."
          }
        }
      }
    },
    "The first boot takes about a minute: wait for it to finish, then quit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Start dauert etwa eine Minute: Warte, bis er abgeschlossen ist, und beende Nido dann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer arranque tarda alrededor de un minuto: espera a que termine y después sal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier démarrage dure environ une minute : attendez qu’il se termine, puis quittez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo avvio dura circa un minuto: aspetta che finisca, poi esci."
          }
        }
      }
    },
    "The first time you turn it on, Nido shows you what leaves the Mac. Local mode is always available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim ersten Aktivieren zeigt dir Nido, was den Mac verlässt. Der Modus „Lokal“ bleibt immer verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez que lo actives, Nido te mostrará qué sale del Mac. El modo Local siempre está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la première activation, Nido vous montre ce qui quitte le Mac. Le mode Local reste toujours disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla prima attivazione Nido ti mostra cosa esce dal Mac. La modalità Locale resta sempre disponibile."
          }
        }
      }
    },
    "The image is still being checked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Image wird noch geprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está comprobando la imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérification de l’image en cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllo dell'immagine in corso."
          }
        }
      }
    },
    "The list applies when you turn on the controlled network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste gilt, sobald du das kontrollierte Netzwerk aktivierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista se aplica cuando activas la red controlada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste s’applique lorsque vous activez le réseau contrôlé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista vale quando attivi la rete controllata."
          }
        }
      }
    },
    "The log also shows the allowed connections, with the bytes sent and received." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Protokoll zeigt auch die erlaubten Verbindungen mit den gesendeten und empfangenen Bytes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro también muestra las conexiones permitidas, con los bytes enviados y recibidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal affiche aussi les connexions autorisées, avec les octets envoyés et reçus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il registro mostra anche i collegamenti permessi, con i byte inviati e ricevuti."
          }
        }
      }
    },
    "The log never contains prompts or answers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Protokoll enthält nie Prompts oder Antworten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro nunca contiene prompts ni respuestas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal ne contient jamais de prompts ni de réponses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il registro non contiene mai prompt né risposte."
          }
        }
      }
    },
    "The log shows blocks, cut connections and summaries. Turn this off to also see the allowed connections." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Protokoll zeigt Blockierungen, getrennte Verbindungen und Übersichten. Deaktiviere die Option, um auch erlaubte Verbindungen zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro muestra bloqueos, conexiones cortadas y resúmenes. Desactívalo para ver también las conexiones permitidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal affiche les blocages, les connexions coupées et les résumés. Désactivez cette option pour voir aussi les connexions autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il registro mostra blocchi, connessioni interrotte e riepiloghi. Disattiva per vedere anche i collegamenti permessi."
          }
        }
      }
    },
    "The macOS account nido ssh logs in to the VM with: the one created in Setup Assistant." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der macOS-Account, mit dem sich nido ssh in der VM anmeldet: der im Systemassistenten erstellte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta de macOS con la que nido ssh entra en la VM: la que se creó en el Asistente de Configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte macOS avec lequel nido ssh se connecte à la VM : celui créé dans l’Assistant réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'account di macOS con cui nido ssh entra nella VM: quello creato nell'assistente iniziale."
          }
        }
      }
    },
    "The maximum tokens per request must be between 1 and 1 000 000." : {
      "comment" : "The number is grouped with spaces, as the limit fields show it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die maximalen Tokens pro Anfrage müssen zwischen 1 und 1 000 000 liegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El máximo de tokens por solicitud debe estar entre 1 y 1 000 000."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le maximum de jetons par requête doit être compris entre 1 et 1 000 000."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il massimo di token per richiesta deve essere tra 1 e 1 000 000."
          }
        }
      }
    },
    "The model %@ is already in the VM: download it again and overwrite it?" : {
      "comment" : "%@ is a model’s name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell %@ ist bereits in der VM: Erneut herunterladen und überschreiben?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo %@ ya está en la VM: ¿descargarlo de nuevo y sobrescribirlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle d’IA %@ est déjà dans la VM : le télécharger à nouveau et le remplacer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello %@ esiste già nella VM: scaricarlo di nuovo e sovrascriverlo?"
          }
        }
      }
    },
    "The model (%@) is deleted from the VM. You can download it again whenever you want." : {
      "comment" : "%@ is the model’s size.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell (%@) wird aus der VM gelöscht. Du kannst es jederzeit erneut herunterladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo (%@) se elimina de la VM. Puedes volver a descargarlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle d’IA (%@) est supprimé de la VM. Vous pouvez le télécharger à nouveau quand vous le souhaitez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello (%@) viene cancellato dalla VM. Puoi scaricarlo di nuovo quando vuoi."
          }
        }
      }
    },
    "The model catalog Hugging Face sent isn’t valid: try again later." : {
      "localizations" : {
