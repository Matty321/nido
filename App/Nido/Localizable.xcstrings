    "%@ Adding asks for Touch ID or the Mac password; removing doesn’t." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Zum Hinzufügen sind Touch ID oder das Passwort deines Mac nötig, zum Entfernen nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Para añadir se pide Touch ID o la contraseña del Mac; para quitar, no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ L’ajout demande Touch ID ou le mot de passe du Mac ; le retrait, non."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Aggiungere chiede Touch ID o la password del Mac; togliere no."
          }
        }
      }
    },
    "%@ Free up space on the Mac and try again." : {
      "comment" : "%@ says that there isn't enough space, a sentence.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Gib Speicherplatz auf dem Mac frei und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Libera espacio en el Mac y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Libérez de l’espace sur le Mac et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Libera spazio sul Mac e riprova."
          }
        }
      }
    },
    "%@ Install it to turn it on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Installiere es, um es zu aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Instálalo para activarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Installez-le pour l’activer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Installala per attivarla."
          }
        }
      }
    },
    "%@ Nido deleted the files it created; the IPSW stays where it is." : {
      "comment" : "%@ is why the installation failed, a sentence.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nido hat die erstellten Dateien gelöscht; die IPSW-Datei bleibt, wo sie ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nido ha eliminado los archivos creados; el IPSW se queda donde está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nido a supprimé les fichiers créés ; le fichier IPSW reste où il est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nido ha cancellato i file creati; l'IPSW resta dov'è."
          }
        }
      }
    },
    "%@ Nido retries automatically every 3 seconds: the VM keeps working normally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nido versucht es alle 3 Sekunden von selbst erneut: Die VM arbeitet normal weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nido vuelve a intentarlo automáticamente cada 3 segundos: la VM sigue funcionando con normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nido réessaie de lui-même toutes les 3 secondes : la VM continue de fonctionner normalement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nido riprova da solo ogni 3 secondi: la VM continua a funzionare normalmente."
          }
        }
      }
    },
    "%@ Settings" : {
      "comment" : "The VM settings window’s title; %@ is the VM’s name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen von %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes de %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages de %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni di %@"
          }
        }
      }
    },
    "%@ The VM starts without Rosetta until it’s available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Die VM startet ohne Rosetta, bis es verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La VM se inicia sin Rosetta hasta que esté disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La VM démarre sans Rosetta tant qu’il n’est pas disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La VM parte senza Rosetta finché non è disponibile."
          }
        }
      }
    },
    "%@ added to the allowed domains of %@: it applies within a few seconds, even with the VM running" : {
      "comment" : "A domain, then the VM’s name. No final period: the app adds it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zu den erlaubten Domains von %@ hinzugefügt: Das gilt innerhalb weniger Sekunden, auch bei laufender VM"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ añadido a los dominios permitidos de %@: se aplica en pocos segundos, incluso con la VM en ejecución"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ajouté aux domaines autorisés de %@ : effectif en quelques secondes, même si la VM est en marche"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aggiunto ai domini permessi di %@: vale entro pochi secondi, anche a VM accesa"
          }
        }
      }
    },
    "%@ and every subdomain of it." : {
      "comment" : "%@ is a domain.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und alle Subdomains davon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ y todos sus subdominios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et tous ses sous-domaines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e ogni suo sottodominio."
          }
        }
      }
    },
    "%@ applies to every name under %@: the sites and services of anyone with an address there, not a single site. Add it only if you really need it; after this confirmation, Touch ID or the Mac password is needed too." : {
      "comment" : "A wildcard (*.co.uk), then the name under it (co.uk).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gilt für jeden Namen unter %@: Websites und Dienste von allen, die dort eine Adresse haben, nicht nur eine einzelne Website. Füge den Eintrag nur hinzu, wenn du ihn wirklich brauchst; nach dieser Bestätigung sind zusätzlich Touch ID oder das Passwort deines Mac nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vale para cualquier nombre bajo %@: sitios y servicios de cualquiera que tenga allí una dirección, no de un solo sitio. Añádelo solo si de verdad lo necesitas; después de esta confirmación también hará falta Touch ID o la contraseña del Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vaut pour tous les noms sous %@ : les sites et services de tous ceux qui y ont une adresse, et non un seul site. Ne l’ajoutez que si vous en avez vraiment besoin ; après cette confirmation, Touch ID ou le mot de passe du Mac sera aussi demandé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vale per ogni nome sotto %@: siti e servizi di chiunque vi abbia un indirizzo, non di un solo sito. Aggiungilo solo se ti serve davvero; dopo questa conferma serve anche Touch ID o la password del Mac."
          }
        }
      }
    },
    "%@ are finishing their first boot: quitting now may leave them without SSH access" : {
      "comment" : "%@ is a list of two or more VM names (“a and b”, “a, b and c”).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ schließen gerade den ersten Start ab: Wenn du Nido jetzt beendest, bleiben sie eventuell ohne SSH-Zugriff"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ están terminando su primer arranque: si sales ahora, pueden quedarse sin acceso SSH"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ terminent leur premier démarrage : quitter maintenant peut les laisser sans accès SSH"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stanno completando il primo avvio: uscire ora può lasciarle senza accesso SSH"
          }
        }
      }
    },
    "%@ available" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verfügbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ disponibles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ disponibles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ disponibili"
          }
        }
      }
    },
    "%@ becomes a template: it no longer starts and is used to create new VMs with an instant copy of its disk. To update it, choose Edit Template, then save it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird zu einer Vorlage: Sie startet nicht mehr und dient dazu, mit einer Sofortkopie ihrer Festplatte neue VMs zu erstellen. Zum Aktualisieren wähle „Vorlage bearbeiten“ und sichere sie danach erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se convierte en una plantilla: ya no se inicia y sirve para crear nuevas VM con una copia instantánea del disco. Para actualizarla, elige Editar plantilla y luego vuelve a guardarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ devient un modèle : elle ne démarre plus et sert à créer de nouvelles VM avec une copie instantanée de son disque. Pour mettre à jour le modèle, choisissez Modifier le modèle, puis enregistrez-le de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ diventa un modello: non si avvia più e serve a creare nuove VM con una copia istantanea del disco. Per aggiornarlo scegli Modifica modello, poi salvalo di nuovo."
          }
        }
      }
    },
    "%@ can’t be suspended in its current configuration: it will be stopped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann mit ihrer Konfiguration nicht in den Ruhezustand versetzt werden und wird deshalb gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se puede suspender con su configuración: se detendrá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être suspendue avec sa configuration : elle sera arrêtée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non si può sospendere con la sua configurazione: verrà arrestata."
          }
        }
      }
    },
    "%@ can’t be suspended in their current configuration: they will be stopped." : {
      "comment" : "%@ is a list of two or more VM names (“a and b”, “a, b and c”).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ können mit ihrer Konfiguration nicht in den Ruhezustand versetzt werden und werden deshalb gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se pueden suspender con su configuración: se detendrán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peuvent pas être suspendues avec leur configuration : elles seront arrêtées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non si possono sospendere con la loro configurazione: verranno arrestate."
          }
        }
      }
    },
    "%@ checksum" : {
      "comment" : "%@ is SHA-512 or SHA-256.",
      "localizations" : {
