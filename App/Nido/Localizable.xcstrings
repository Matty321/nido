    "That folder isn’t in your PATH. Add this line to ~/.zshrc:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ordner ist nicht in deinem PATH. Füge diese Zeile zu ~/.zshrc hinzu:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa carpeta no está en tu PATH. Añade esta línea a ~/.zshrc:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce dossier ne figure pas dans votre PATH. Ajoutez cette ligne à ~/.zshrc :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella cartella non è nel PATH. Aggiungi questa riga a ~/.zshrc:"
          }
        }
      }
    },
    "The %@ checksum doesn’t match: the downloaded file was deleted. Try again: Nido downloads the image again." : {
      "comment" : "%@ is SHA-512 or SHA-256.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %@-Prüfsumme stimmt nicht überein: Die heruntergeladene Datei wurde gelöscht. Versuche es erneut: Nido lädt das Image noch einmal herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suma de control %@ no coincide: se ha eliminado el archivo descargado. Vuelve a intentarlo: Nido descargará de nuevo la imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La somme de contrôle %@ ne correspond pas : le fichier téléchargé a été supprimé. Réessayez : Nido télécharge de nouveau l’image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il checksum %@ non corrisponde: il file scaricato è stato eliminato. Riprova: Nido scarica di nuovo l'immagine."
          }
        }
      }
    },
    "The AI bridge isn’t available in this session" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Brücke ist in dieser Sitzung nicht verfügbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puente de IA no está disponible en esta sesión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pont IA n’est pas disponible dans cette session"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ponte AI non è disponibile in questa sessione"
          }
        }
      }
    },
    "The AI bridge isn’t available in this session: the VM’s requests don’t reach Hugging Face. Restart the VM to try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Brücke ist in dieser Sitzung nicht verfügbar: Die Anfragen der VM erreichen Hugging Face nicht. Starte die VM neu, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puente de IA no está disponible en esta sesión: las solicitudes de la VM no llegan a Hugging Face. Reinicia la VM para volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pont IA n’est pas disponible dans cette session : les requêtes de la VM n’atteignent pas Hugging Face. Redémarrez la VM pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ponte AI non è disponibile in questa sessione: le richieste della VM non arrivano a Hugging Face. Riavvia la VM per riprovare."
          }
        }
      }
    },
    "The AI bridge works only for VMs started by Nido: %@ was started from Terminal (nido start)." : {
      "comment" : "%@ is the VM’s name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Brücke funktioniert nur für VMs, die Nido gestartet hat: %@ wurde im Terminal gestartet (nido start)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puente de IA solo funciona con las VM iniciadas desde Nido: %@ se ha iniciado desde Terminal (nido start)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pont IA ne fonctionne que pour les VM démarrées par Nido : %@ a été démarrée depuis Terminal (nido start)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ponte AI funziona solo per le VM avviate da Nido: %@ è in esecuzione dal Terminale (nido start)."
          }
        }
      }
    },
    "The Guest Tools of %@ are already up to date." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Guest Tools von %@ sind bereits aktuell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Guest Tools de %@ ya están actualizadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Guest Tools de %@ sont déjà à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Guest Tools di %@ sono già aggiornati."
          }
        }
      }
    },
    "The Guest Tools of %@ don’t respond" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Guest Tools von %@ antworten nicht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Guest Tools de %@ no responden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Guest Tools de %@ ne répondent pas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Guest Tools di %@ non rispondono"
          }
        }
      }
    },
    "The Guest Tools of %@ report an unknown version. Update Nido, or reinstall the Guest Tools that come with your version of Nido." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Guest Tools von %@ melden eine unbekannte Version. Aktualisiere Nido oder installiere die Guest Tools, die zu deiner Nido-Version gehören, erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Guest Tools de %@ indican una versión desconocida. Actualiza Nido o reinstala las Guest Tools que incluye tu versión de Nido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Guest Tools de %@ indiquent une version inconnue. Mettez à jour Nido ou réinstallez les Guest Tools fournis avec votre version de Nido."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Guest Tools di %@ rispondono con la versione sconosciuta, che questa versione di Nido non conosce. Aggiorna Nido, oppure reinstalla i Guest Tools della versione di Nido che usi."
          }
        }
      }
    },
    "The Guest Tools of %@ report version %@, which this version of Nido doesn’t recognize. Update Nido, or reinstall the Guest Tools that come with your version of Nido." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Guest Tools von %@ melden die Version %@, die diese Version von Nido nicht erkennt. Aktualisiere Nido oder installiere die Guest Tools, die zu deiner Nido-Version gehören, erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Guest Tools de %@ indican la versión %@, que esta versión de Nido no reconoce. Actualiza Nido o reinstala las Guest Tools que incluye tu versión de Nido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Guest Tools de %@ indiquent la version %@, que cette version de Nido ne reconnaît pas. Mettez à jour Nido ou réinstallez les Guest Tools fournis avec votre version de Nido."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Guest Tools di %@ rispondono con la versione %@, che questa versione di Nido non conosce. Aggiorna Nido, oppure reinstalla i Guest Tools della versione di Nido che usi."
          }
        }
      }
    },
    "The Hugging Face token is missing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Token für Hugging Face fehlt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el token de Hugging Face"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton Hugging Face est manquant"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca il token di Hugging Face"
          }
        }
      }
    },
    "The Hugging Face token is missing: add it in Nido Settings. Until then, the VM’s requests get a 401 error and nothing leaves the Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Token für Hugging Face fehlt: Füge es in den Einstellungen von Nido hinzu. Bis dahin erhalten die Anfragen der VM den Fehler 401 und nichts verlässt den Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el token de Hugging Face: añádelo en Ajustes de Nido. Mientras falte, las solicitudes de la VM reciben un error 401 y nada sale del Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton Hugging Face est manquant : ajoutez-le dans les Réglages de Nido. D’ici là, les requêtes de la VM reçoivent une erreur 401 et rien ne quitte le Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca il token di Hugging Face: aggiungilo nelle Impostazioni di Nido. Finché manca, le richieste della VM ricevono un errore 401 e nulla esce dal Mac."
          }
        }
      }
    },
    "The Keychain didn’t remove the token: try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüsselbund hat das Token nicht entfernt: Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Llavero no ha eliminado el token: vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trousseau n’a pas supprimé le jeton : réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Portachiavi non ha rimosso il token: riprova."
          }
        }
      }
    },
    "The Keychain didn’t save the token: try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüsselbund hat das Token nicht gesichert: Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Llavero no ha guardado el token: vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trousseau n’a pas enregistré le jeton : réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Portachiavi non ha salvato il token: riprova."
          }
        }
      }
    },
    "The Keychain doesn’t respond: try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüsselbund antwortet nicht: Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Llavero no responde: vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trousseau ne répond pas : réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Portachiavi non risponde: riprova."
          }
        }
      }
    },
    "The Keychain isn’t available in this session of Nido: the token can’t be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüsselbund ist in dieser Sitzung von Nido nicht verfügbar: Das Token kann nicht gesichert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Llavero no está disponible en esta sesión de Nido: el token no se puede guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trousseau n’est pas disponible dans cette session de Nido : le jeton ne peut pas être enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Portachiavi non è disponibile in questa sessione di Nido: il token non si può salvare."
          }
        }
      }
    },
    "The VM and its disk (%@) will be deleted from this Mac. This can’t be undone." : {
      "comment" : "The disk's size, e.g. 64 GiB.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM und ihre Festplatte (%@) werden von diesem Mac gelöscht. Dieser Vorgang kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM y su disco (%@) se eliminarán de este Mac. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM et son disque (%@) seront supprimés de ce Mac. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM e il suo disco (%@) saranno eliminati da questo Mac. L'operazione non si può annullare."
          }
        }
      }
    },
    "The VM and its disk will be deleted from this Mac. This can’t be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM und ihre Festplatte werden von diesem Mac gelöscht. Dieser Vorgang kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM y su disco se eliminarán de este Mac. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM et son disque seront supprimés de ce Mac. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM e il suo disco saranno eliminati da questo Mac. L'operazione non si può annullare."
          }
        }
      }
    },
    "The VM can change and delete the files in this folder on the Mac: turn this on only if you need it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM kann die Dateien dieses Ordners auf dem Mac ändern und löschen: Aktiviere das nur, wenn du es brauchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM puede modificar y eliminar los archivos de esta carpeta en el Mac: actívalo solo si lo necesitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM peut modifier et supprimer les fichiers de ce dossier sur le Mac : activez cette option seulement si vous en avez besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM può modificare e cancellare i file di questa cartella sul Mac: attiva solo se ti serve."
          }
        }
      }
    },
    "The VM can reach only Apple’s servers for activation, macOS updates and the clock. The App Store, iCloud and other sites stay blocked until you add their domains in the VM’s settings, Network section." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM erreicht nur die Server von Apple für Aktivierung, macOS-Updates und Uhrzeit. App Store, iCloud und andere Websites bleiben blockiert, bis du ihre Domains in den Einstellungen der VM im Bereich „Netzwerk“ hinzufügst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM solo puede acceder a los servidores de Apple para la activación, las actualizaciones de macOS y el reloj. El App Store, iCloud y los demás sitios siguen bloqueados hasta que añadas sus dominios en los ajustes de la VM, sección Red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM n’accède qu’aux serveurs d’Apple pour l’activation, les mises à jour de macOS et l’horloge. L’App Store, iCloud et les autres sites restent bloqués tant que vous n’ajoutez pas leurs domaines dans les réglages de la VM, section Réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM raggiunge solo l'attivazione, gli aggiornamenti di macOS e l'orologio. App Store, iCloud e gli altri siti restano bloccati finché non aggiungi i loro domini nelle impostazioni della VM, sezione Rete."
          }
        }
      }
    },
    "The VM can’t reach any site. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM erreicht keine Website. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM no puede acceder a ningún sitio. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM n’atteint aucun site. %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM non raggiunge nessun sito. %@"
          }
        }
      }
    },
    "The VM can’t see any files on the Mac. Add a folder to make it visible in %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM sieht keine Dateien des Mac. Füge einen Ordner hinzu, damit er unter %@ sichtbar wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM no ve ningún archivo del Mac. Añade una carpeta para que se vea en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM ne voit aucun fichier du Mac. Ajoutez un dossier pour le rendre visible dans %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM non vede alcun file del Mac. Aggiungi una cartella per renderla visibile in %@."
          }
        }
      }
    },
    "The VM doesn’t respond to commands" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM reagiert nicht auf Befehle"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM no responde a los comandos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM ne répond pas aux commandes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM non risponde ai comandi"
          }
        }
      }
    },
    "The VM has no swap area" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM hat keinen Swap-Bereich"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM no tiene área de swap"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM n’a pas d’espace de swap"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM non ha un'area di swap"
          }
        }
      }
    },
    "The VM is no longer running: the command may be only partly typed. Clear the line in the VM’s Terminal before you try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM läuft nicht mehr: Der Befehl steht eventuell nur zum Teil da. Lösche die Zeile im Terminal der VM, bevor du es erneut versuchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM ya no está en ejecución: puede que el comando esté escrito solo en parte. Borra la línea en la app Terminal de la VM antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM n’est plus en marche : la commande n’est peut-être saisie qu’en partie. Effacez la ligne dans le Terminal de la VM avant de réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM non è più in esecuzione: il comando potrebbe essere scritto solo in parte. Cancella la riga nel Terminale della VM prima di riprovare."
          }
        }
      }
    },
    "The VM is running: connections to domains outside the base list are cut." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM läuft: Verbindungen zu Domains außerhalb der Basisliste werden getrennt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM está en ejecución: las conexiones hacia dominios fuera de la lista básica se cortan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM est en marche : les connexions vers des domaines hors de la liste de base sont coupées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM è accesa: le connessioni verso domini fuori dalla lista di base vengono interrotte."
          }
        }
      }
    },
    "The VM is usable before then: the progress stays visible in its window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM ist schon vorher nutzbar: Der Fortschritt bleibt in ihrem Fenster sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM se puede usar antes: el progreso sigue visible en su ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM est utilisable avant la fin : la progression reste visible dans sa fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM è usabile prima: l'avanzamento resta visibile nella sua finestra."
          }
        }
      }
    },
    "The VM isn’t running" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM läuft nicht"
          }
