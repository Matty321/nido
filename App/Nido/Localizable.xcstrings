    "Apple network" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-Netzwerk"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Red de Apple"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réseau Apple"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rete di Apple"
          }
        }
      }
    },
    "Apple network (NAT): the VM connects to the internet unchecked and no connection is logged. You can turn on the controlled network in the settings, with the VM stopped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-Netzwerk (NAT): Die VM greift ohne Kontrolle auf das Internet zu, und es wird keine Verbindung protokolliert. Du kannst das kontrollierte Netzwerk in den Einstellungen aktivieren, wenn die VM gestoppt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Red de Apple (NAT): la VM sale sin controles y no se registra ninguna conexión. Puedes activar la red controlada en los ajustes, con la VM detenida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réseau Apple (NAT) : la VM sort sans contrôle et aucune connexion n’est enregistrée. Vous pouvez activer le réseau contrôlé dans les réglages, lorsque la VM est arrêtée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rete di Apple (NAT): la VM esce senza controlli e nessun collegamento viene registrato. Puoi attivare la rete controllata dalle impostazioni, a VM arrestata."
          }
        }
      }
    },
    "Applied at once: %@ is running and now sees the folders as you set them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sofort übernommen: %@ läuft und sieht die Ordner jetzt so, wie du sie eingestellt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicado al momento: %@, en ejecución, ya ve las carpetas tal como las has configurado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliqué aussitôt : %@, en marche, voit maintenant les dossiers tels que vous les avez réglés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha effetto subito: %@ in esecuzione vede ora le cartelle come le hai impostate."
          }
        }
      }
    },
