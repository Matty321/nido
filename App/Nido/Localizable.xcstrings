    "Suspend" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhezustand"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspender"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sospendi"
          }
        }
      }
    },
    "Suspend and Quit" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Ruhezustand versetzen und beenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspender y salir"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendre et quitter"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sospendi ed esci"
          }
        }
      }
    },
    "Suspend and Quit saves the state of %@ on the Mac: the next start continues where you left off. Stop and Quit asks it to shut down cleanly and, if it’s still running after 30 seconds, forces it to stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„In Ruhezustand versetzen und beenden“ sichert den Zustand von %@ auf dem Mac: Beim nächsten Start geht es dort weiter, wo du aufgehört hast. „Stoppen und beenden“ fordert sie auf, sich ordnungsgemäß herunterzufahren, und erzwingt den Stopp, wenn sie nach 30 Sekunden noch läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspender y salir guarda el estado de %@ en el Mac: el próximo inicio continúa donde lo dejaste. Detener y salir le pide que se apague de forma ordenada y, si sigue en ejecución pasados 30 segundos, la detiene a la fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendre et quitter enregistre l’état de %@ sur le Mac : le prochain démarrage reprend là où vous l’aviez laissée. Arrêter et quitter lui demande de s’éteindre proprement et force son arrêt si elle est encore en marche après 30 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sospendi ed esci salva lo stato di %@ sul Mac: al prossimo avvio riparte da dove l'hai lasciata. Arresta ed esci le chiede di spegnersi in modo ordinato e, se dopo 30 secondi è ancora accesa, la arresta forzatamente."
          }
        }
      }
    },
    "Suspend and Quit saves the state of each virtual machine on the Mac: the next start continues each one where you left off. Stop and Quit asks each one to shut down cleanly and forces those still running after 30 seconds to stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„In Ruhezustand versetzen und beenden“ sichert den Zustand jeder virtuellen Maschine auf dem Mac: Beim nächsten Start geht es bei jeder dort weiter, wo du aufgehört hast. „Stoppen und beenden“ fordert jede auf, sich ordnungsgemäß herunterzufahren, und erzwingt bei allen, die nach 30 Sekunden noch laufen, den Stopp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspender y salir guarda el estado de cada máquina virtual en el Mac: el próximo inicio continúa cada una donde la dejaste. Detener y salir pide a cada una que se apague de forma ordenada y detiene a la fuerza las que sigan en ejecución pasados 30 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendre et quitter enregistre l’état de chaque machine virtuelle sur le Mac : le prochain démarrage reprend chacune là où vous l’aviez laissée. Arrêter et quitter demande à chacune de s’éteindre proprement et force l’arrêt de celles encore en marche après 30 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sospendi ed esci salva lo stato di ogni macchina virtuale sul Mac: al prossimo avvio ognuna riparte da dove l'hai lasciata. Arresta ed esci chiede a ognuna di spegnersi in modo ordinato e arresta forzatamente quelle ancora accese dopo 30 secondi."
          }
        }
      }
    },
    "Suspend failed: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhezustand fehlgeschlagen: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido suspender: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
