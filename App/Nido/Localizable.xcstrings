          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rimanenti"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Downloaded so far of the total: 0.4 GiB of 1.2 GiB.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
