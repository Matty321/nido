    },
    "The VM isn’t running: start it to manage Ollama." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM läuft nicht: Starte sie, um Ollama zu verwalten."
