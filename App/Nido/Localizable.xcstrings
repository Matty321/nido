    "Nido Settings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes de Nido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages de Nido"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni di Nido"
          }
        }
      }
    },
    "Nido asks %@ to shut down cleanly, then closes the window. If it’s still running after 30 seconds, Nido forces it to stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido fordert %@ auf, sich ordnungsgemäß herunterzufahren, und schließt dann das Fenster. Läuft sie nach 30 Sekunden noch, erzwingt Nido den Stopp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido pide a %@ que se apague de forma ordenada y después cierra la ventana. Si sigue en ejecución pasados 30 segundos, Nido la detiene a la fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido demande à %@ de s’éteindre proprement, puis ferme la fenêtre. Si elle est encore en marche après 30 secondes, Nido force son arrêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido chiede a %@ di spegnersi in modo ordinato, poi chiude la finestra. Se dopo 30 secondi è ancora accesa, la arresta forzatamente."
          }
        }
      }
    },
    "Nido asks before quitting; the files it created are deleted and the IPSW stays where it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido fragt vor dem Beenden nach; die erstellten Dateien werden gelöscht und die IPSW-Datei bleibt, wo sie ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido te lo pregunta antes de salir; los archivos creados se eliminan y el IPSW se queda donde está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido demande confirmation avant de quitter ; les fichiers créés sont supprimés et le fichier IPSW reste où il est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di uscire Nido te lo chiede; i file creati vengono cancellati, l'IPSW resta dov'è."
          }
        }
      }
    },
    "Nido asks the guest every 3 seconds" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido fragt das Gastsystem alle 3 Sekunden ab"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido pregunta al sistema invitado cada 3 segundos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido interroge le système invité toutes les 3 secondes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido chiede al guest ogni 3 secondi"
          }
        }
      }
    },
    "Nido can’t connect to %@ over SSH" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido kann sich nicht über SSH mit %@ verbinden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido no puede conectarse a %@ por SSH"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido ne parvient pas à se connecter à %@ via SSH"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido non riesce a collegarsi a %@ via SSH"
          }
        }
      }
    },
    "Nido closes and reopens in the chosen language. With a VM running, it asks first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido wird beendet und in der gewählten Sprache wieder geöffnet. Läuft eine VM, fragt Nido vorher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido se cierra y se vuelve a abrir en el idioma elegido. Si hay una VM en ejecución, pregunta antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido se ferme et se rouvre dans la langue choisie. Si une VM est en marche, Nido demande d’abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido si chiude e si riapre nella lingua scelta. Con una VM accesa, prima chiede."
          }
        }
      }
    },
    "Nido downloads it again from the Ollama library and replaces the one in the VM." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido lädt es erneut aus der Ollama-Bibliothek herunter und ersetzt das Modell in der VM."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido lo vuelve a descargar de la biblioteca de Ollama y sustituye el que hay en la VM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido le télécharge à nouveau depuis la bibliothèque d’Ollama et remplace celui de la VM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido lo scarica di nuovo dalla libreria di Ollama e sostituisce quello nella VM."
          }
        }
      }
    },
    "Nido downloads the official image and checks its integrity before using it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido lädt das offizielle Image herunter und prüft vor der Verwendung seine Integrität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido descarga la imagen oficial y comprueba su integridad antes de usarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido télécharge l’image officielle et vérifie son intégrité avant de l’utiliser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido scarica l'immagine ufficiale e ne controlla l'integrità prima di usarla."
          }
        }
      }
    },
    "Nido installs Ollama from the official sources, in the version Nido has verified, and runs it as a service of the VM on 127.0.0.1:11434." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido installiert Ollama aus den offiziellen Quellen in der von Nido geprüften Version und startet es als Dienst der VM unter 127.0.0.1:11434."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido instala Ollama desde las fuentes oficiales, en la versión verificada por Nido, y lo inicia como servicio de la VM en 127.0.0.1:11434."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido installe Ollama depuis les sources officielles, dans la version vérifiée par Nido, et le lance comme service de la VM sur 127.0.0.1:11434."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido installa Ollama dalle fonti ufficiali, nella versione verificata da Nido, e lo avvia come servizio della VM su 127.0.0.1:11434."
          }
        }
      }
    },
    "Nido installs it from the official sources once the VM is ready: you can already use the VM while it downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido installiert es aus den offiziellen Quellen, sobald die VM bereit ist: Du kannst sie schon verwenden, während Ollama heruntergeladen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido lo instala desde las fuentes oficiales cuando la VM está lista: puedes usarla mientras se descarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido l’installe depuis les sources officielles dès que la VM est prête : vous pouvez déjà l’utiliser pendant le téléchargement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido lo installa dalle fonti ufficiali quando la VM è pronta: puoi già usarla mentre scarica."
          }
        }
      }
    },
    "Nido is copying the disk and settings of %@." : {
      "comment" : "%@ is the VM's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido kopiert Festplatte und Einstellungen von %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido está copiando el disco y los ajustes de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido copie le disque et les réglages de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido copia disco e impostazioni di %@."
          }
        }
      }
    },
    "Nido is copying the disk, settings and suspended state of %@." : {
      "comment" : "%@ is the VM's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido kopiert Festplatte, Einstellungen und gesicherten Zustand von %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido está copiando el disco, los ajustes y el estado suspendido de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido copie le disque, les réglages et l’état suspendu de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido copia disco, impostazioni e stato sospeso di %@."
          }
        }
      }
    },
    "Nido is creating the virtual machine. Nido will quit as soon as the VM is ready, so no half-made VM is left behind." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido erstellt die virtuelle Maschine und wird beendet, sobald die VM fertig ist. So bleibt keine halb erstellte VM zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido está creando la máquina virtual. Nido se cerrará en cuanto la VM esté lista, para que no quede una VM a medias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido crée la machine virtuelle. Nido quittera dès que la VM sera prête, pour ne pas laisser de VM à moitié créée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido sta creando la macchina virtuale. Esce appena la creazione è finita, così non resta una VM a metà."
          }
        }
      }
    },
    "Nido is downloading the Linux image. Quitting stops the download and deletes the partial file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido lädt das Linux-Image herunter. Beim Beenden wird der Download abgebrochen und die unvollständige Datei gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido está descargando la imagen de Linux. Si sales, la descarga se detiene y se elimina el archivo parcial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido télécharge l’image Linux. Si vous quittez, le téléchargement s’arrête et le fichier partiel est supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido sta scaricando l'immagine di Linux. Uscendo il download si interrompe e il file parziale viene eliminato."
          }
        }
      }
    },
    "Nido is free software: its code is public." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido ist freie Software: Der Code ist öffentlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido es software libre: su código es público."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido est un logiciel libre : son code est public."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido è software libero: il codice è pubblico."
          }
        }
      }
    },
    "Nido is installing macOS %@ on %@. You can close the wizard: the progress stays in the library." : {
      "comment" : "%1$@: the macOS version; %2$@: the new VM's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido installiert macOS %@ auf %@. Du kannst den Assistenten schließen: Der Fortschritt bleibt in der Bibliothek sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido está instalando macOS %@ en %@. Puedes cerrar el asistente: el progreso sigue en la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido installe macOS %@ sur %@. Vous pouvez fermer l’assistant : la progression reste visible dans la bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido installa macOS %@ in %@. Puoi chiudere la procedura: l'avanzamento resta nella libreria."
          }
        }
      }
    },
    "Nido is quitting: no new snapshot operations" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido wird beendet: keine neuen Schnappschuss-Vorgänge"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido se está cerrando: no se inician más operaciones con instantáneas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido se ferme : aucune nouvelle opération sur les instantanés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido si sta chiudendo: nessuna nuova operazione sugli snapshot"
          }
        }
      }
    },
    "Nido is working on %@ (a clone or a snapshot): try again when it’s done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido arbeitet gerade an %@ (Klonen oder Schnappschuss): Versuche es danach erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido está trabajando con %@ (un clon o una instantánea): vuelve a intentarlo cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido travaille sur %@ (un clone ou un instantané) : réessayez une fois l’opération terminée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso un'operazione su %@ in Nido (clonazione o snapshot): riprova al termine."
          }
        }
      }
    },
    "Nido keeps the VMs in a folder it shares with the nido command." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido bewahrt die VMs in einem Ordner auf, den es mit dem Befehl nido teilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido guarda las VM en una carpeta que comparte con el comando nido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido conserve les VM dans un dossier qu’il partage avec la commande nido."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido conserva le VM in una cartella condivisa con il comando nido."
          }
        }
      }
    },
    "Nido never asks for or saves passwords." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido fragt keine Passwörter ab und speichert keine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido no pide ni guarda contraseñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido ne demande ni n’enregistre aucun mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido non chiede né salva password."
          }
        }
      }
    },
    "Nido only reads it: it doesn’t download, copy, move or change it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido liest die Datei nur: Sie wird weder heruntergeladen noch kopiert, verschoben oder geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido solo lo lee: no lo descarga, ni lo copia, ni lo mueve, ni lo modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido se contente de le lire : il ne le télécharge pas, ne le copie pas, ne le déplace pas et ne le modifie pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido lo legge soltanto: non lo scarica, non lo copia, non lo sposta e non lo modifica."
          }
        }
      }
    },
    "Nido reads the IPSW and checks that this Mac can install it: usually a few seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido liest die IPSW-Datei und prüft, ob dieser Mac sie installieren kann. Das dauert meist nur wenige Sekunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido lee el IPSW y comprueba que este Mac pueda instalarlo: suele tardar unos segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido lit le fichier IPSW et vérifie que ce Mac peut l’installer : quelques secondes en général."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido legge l'IPSW e verifica che questo Mac possa installarlo: di solito pochi secondi."
          }
        }
      }
    },
    "Nido saves the disk and settings of %@ as they are now." : {
      "comment" : "%@ is the VM's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido sichert Festplatte und Einstellungen von %@ im aktuellen Zustand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido guarda el disco y los ajustes de %@ tal como están ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido enregistre le disque et les réglages de %@ tels qu’ils sont maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido salva disco e impostazioni di %@ così come sono adesso."
          }
        }
      }
    },
    "Nido stopped waiting: the operation continues in the VM and the status updates automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido wartet nicht mehr: Der Vorgang läuft in der VM weiter und der Status aktualisiert sich von selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido ha dejado de esperar: la operación sigue en la VM y el estado se actualiza solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido a cessé d’attendre : l’opération se poursuit dans la VM et l’état se met à jour tout seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido ha smesso di attendere: l'operazione continua nella VM e lo stato si aggiorna da solo."
          }
        }
      }
    },
    "Nido stopped waiting: the operation goes on in the VM and the AI view shows how it ends." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido wartet nicht mehr: Der Vorgang läuft in der VM weiter und die KI-Ansicht zeigt das Ergebnis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido ha dejado de esperar: la operación sigue en la VM y la vista de IA muestra el resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido a cessé d’attendre : l’opération se poursuit dans la VM et la vue IA en montre le résultat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido ha smesso di attendere: l'operazione continua nella VM e la vista AI ne mostra l'esito."
          }
        }
      }
    },
    "Nido stops installing %@ and deletes the files created so far. The IPSW stays where it is." : {
      "comment" : "%@ is one or more VM names.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido bricht die Installation von %@ ab und löscht die bisher erstellten Dateien. Die IPSW-Datei bleibt, wo sie ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido detiene la instalación de %@ y elimina los archivos creados hasta ahora. El IPSW se queda donde está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido arrête l’installation de %@ et supprime les fichiers créés jusqu’ici. Le fichier IPSW reste où il est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido ferma l'installazione di %@ e cancella i file creati finora. L'IPSW resta dov'è."
          }
        }
      }
    },
    "Nido stops the installation and deletes the files created so far. The IPSW stays where it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido bricht die Installation ab und löscht die bisher erstellten Dateien. Die IPSW-Datei bleibt, wo sie ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido detiene la instalación y elimina los archivos creados hasta ahora. El IPSW se queda donde está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido arrête l’installation et supprime les fichiers créés jusqu’ici. Le fichier IPSW reste où il est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido ferma l'installazione e cancella i file creati finora. L'IPSW resta dov'è."
          }
        }
      }
    },
    "Nido stops the service and removes Ollama from the VM. The models stay, unless you choose to delete them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido stoppt den Dienst und entfernt Ollama aus der VM. Die Modelle bleiben erhalten, außer du entscheidest dich, sie zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido detiene el servicio y elimina Ollama de la VM. Los modelos se conservan, salvo que decidas eliminarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido arrête le service et supprime Ollama de la VM. Les modèles d’IA sont conservés, sauf si vous choisissez de les supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido ferma il servizio e rimuove Ollama dalla VM. I modelli restano, a meno che tu non scelga di cancellarli."
          }
        }
      }
    },
    "Nido uses this Mac’s keyboard layout: if the VM’s is different, type the command yourself. Keep Caps Lock off in the VM." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido verwendet das Tastaturlayout dieses Mac: Ist es in der VM ein anderes, gib den Befehl selbst ein. Lass die Feststelltaste in der VM ausgeschaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido usa la distribución de teclado de este Mac: si la de la VM es distinta, escribe el comando tú mismo. Mantén desactivado Bloq Mayús en la VM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido utilise la disposition du clavier de ce Mac : si celle de la VM est différente, saisissez la commande vous-même. Laissez le verrouillage des majuscules désactivé dans la VM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido usa la disposizione della tastiera di questo Mac: se nella VM è diversa, digita il comando a mano. Tieni spento Blocco maiuscole nella VM."
          }
        }
      }
    },
    "Nido will quit as soon as the snapshot operation on %@ is done, so the VM’s files stay intact." : {
      "comment" : "One VM's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido wird beendet, sobald der Schnappschuss-Vorgang für %@ abgeschlossen ist, damit die Dateien der VM intakt bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido se cerrará en cuanto termine la operación con las instantáneas de %@, para que los archivos de la VM queden intactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido quittera dès que l’opération sur les instantanés de %@ sera terminée, afin que les fichiers de la VM restent intacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido esce appena l'operazione sugli snapshot di %@ è finita, così i file della VM restano integri."
          }
        }
      }
    },
    "Nido will quit as soon as the snapshot operations on %@ are done, so the VMs’ files stay intact." : {
      "comment" : "Several VM names, separated by commas.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido wird beendet, sobald die Schnappschuss-Vorgänge für %@ abgeschlossen sind, damit die Dateien der VMs intakt bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido se cerrará en cuanto terminen las operaciones con las instantáneas de %@, para que los archivos de las VM queden intactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido quittera dès que les opérations sur les instantanés de %@ seront terminées, afin que les fichiers des VM restent intacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido esce appena le operazioni sugli snapshot di %@ sono finite, così i file delle VM restano integri."
          }
        }
      }
    },
    "Nido will update when no VM is running. Running now: %@." : {
      "comment" : "The running VMs' names, separated by commas.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido wird aktualisiert, sobald keine VM mehr läuft. Aktuell laufen: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido se actualizará cuando no haya ninguna VM en ejecución. En ejecución ahora: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido se mettra à jour quand aucune VM ne sera en marche. En marche actuellement : %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nido si aggiornerà quando nessuna VM sarà accesa. Accese ora: %@."
          }
        }
      }
    },
    "Nido’s notifications are turned off" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mitteilungen von Nido sind deaktiviert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de Nido están desactivadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications de Nido sont désactivées"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche di Nido sono disattivate"
          }
        }
      }
    },
    "Nido’s software inside the VM: the monitor, the Ollama setup and the AI bridge. Nido installs it over SSH with the VM’s key; packages, files and models stay as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Software von Nido in der VM: Monitor, Einrichtung von Ollama und KI-Brücke. Nido installiert sie über SSH mit dem Schlüssel der VM; Pakete, Dateien und Modelle bleiben, wie sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El software de Nido dentro de la VM: el monitor, la preparación de Ollama y el puente de IA. Nido lo instala por SSH con la clave de la VM; los paquetes, los archivos y los modelos se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le logiciel de Nido dans la VM : le moniteur, la préparation d’Ollama et le pont IA. Nido l’installe via SSH avec la clé de la VM ; les paquets, les fichiers et les modèles d’IA restent tels quels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il software di Nido dentro la VM: monitor, preparazione di Ollama e ponte AI. Nido lo installa via SSH con la chiave della VM; pacchetti, file e modelli restano come sono."
          }
        }
      }
    },
    "No allowed domains" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine erlaubten Domains"
          }
        },
        "es" : {
