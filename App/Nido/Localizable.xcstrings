    "Start %@ to see CPU, memory and disk. The monitor reads the data from the guest over vsock, without going through the network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte %@, um CPU, Arbeitsspeicher und Festplatte zu sehen. Der Monitor liest die Daten über vsock aus dem Gastsystem, ohne Umweg über das Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia %@ para ver la CPU, la memoria y el disco. El monitor lee los datos del sistema invitado por vsock, sin pasar por la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrez %@ pour voir le CPU, la mémoire et le disque. Le moniteur lit les données du système invité via vsock, sans passer par le réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia %@ per vedere CPU, memoria e disco. Il monitor legge i dati dal guest via vsock, senza passare dalla rete."
          }
        }
      }
    },
