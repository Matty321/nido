            "state" : "translated",
            "value" : "%@: %@."
          }
        }
      }
    },
    "%@’s egress.json is replaced with the base list (%@)." : {
      "comment" : "The VM’s name, then the base list’s domains separated by commas.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei egress.json von %@ wird durch die Basisliste ersetzt (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo egress.json de %@ se sustituye por la lista básica (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier egress.json de %@ est remplacé par la liste de base (%@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "egress.json di %@ viene sostituito con la lista di base (%@)."
          }
        }
      }
    },
    "%@’s egress.json isn’t valid: the VM stays on the last valid list. Reset to the base list from the VM’s settings (Network) or with nido net reset %@" : {
      "comment" : "%@ is the VM’s name, twice. No final period: the app adds it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei egress.json von %@ ist ungültig: Die VM behält die letzte gültige Liste. Setze sie in den Einstellungen der VM (Netzwerk) oder mit nido net reset %@ auf die Basisliste zurück"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo egress.json de %@ no es válido: la VM se queda con la última lista válida. Restablece la lista básica desde los ajustes de la VM (Red) o con nido net reset %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
