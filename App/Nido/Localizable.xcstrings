    "Download gets it and replaces the cached copy once it’s verified. Existing VMs don’t change." : {
      "comment" : "“Download” is the wizard's button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Laden“ lädt ihn herunter und ersetzt nach der Prüfung die Kopie im Cache. Bestehende VMs ändern sich nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón Descargar la obtiene y sustituye la copia de la caché tras verificarla. Las VM ya creadas no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton Télécharger le récupère et remplace la copie en cache après vérification. Les VM existantes ne changent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante Scarica la scarica e sostituisce quella nella cache dopo la verifica. Le VM già create non cambiano."
          }
        }
      }
    },
